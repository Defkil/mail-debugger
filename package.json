{
  "name": "mail-debugger",
  "version": "0.3.2",
  "license": "MIT",
  "description": "Lightweight fake SMTP server that catches emails during development. Inspect, filter, and manage caught emails through a REST API, web UI, or terminal client.",
  "type": "module",
  "homepage": "https://github.com/Defkil/mail-debugger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defkil/mail-debugger.git"
  },
  "bugs": {
    "url": "https://github.com/Defkil/mail-debugger/issues"
  },
  "keywords": [
    "smtp",
    "email",
    "mail",
    "debugger",
    "fake-smtp",
    "maildev",
    "catch-all",
    "testing",
    "development"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "mail-debugger": "apps/server/dist/main.mjs"
  },
  "exports": {
    "./client": {
      "types": "./libs/client/dist/index.d.ts",
      "import": "./libs/client/dist/index.js",
      "default": "./libs/client/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "husky",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "e2e": "nx run @mail-debugger/server-e2e:e2e",
    "format:check": "prettier --check .",
    "prepack": "nx build @mail-debugger/server --skip-nx-cache"
  },
  "files": [
    "apps/server/dist",
    "libs/client/dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@elysiajs/node": "1.4.5",
    "@elysiajs/openapi": "1.4.16",
    "@rezi-ui/native": "0.1.0-beta.2",
    "@sinclair/typebox": "0.34.52",
    "elysia": "1.4.30",
    "imapkit": "5.0.1",
    "mailparser": "3.9.38",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "selfsigned": "5.5.0",
    "smtp-server": "3.19.21",
    "sql.js": "1.14.2",
    "srvx": "0.11.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/esbuild": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/node": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/svelte-query": "6.3.1",
    "@tanstack/svelte-table": "9.2.8",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/smtp-server": "3.5.13",
    "@types/sql.js": "1.4.11",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "eslint-plugin-unicorn": "77.0.0",
    "husky": "9.1.7",
    "imapflow": "2.4.0",
    "jsonc-eslint-parser": "3.3.0",
    "lint-staged": "17.6.0",
    "nodemailer": "10.1.0",
    "nx": "23.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
