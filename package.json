{
  "name": "mail-debugger",
  "version": "0.3.2",
  "license": "MIT",
  "description": "Lightweight fake SMTP server that catches emails during development. Inspect, filter, and manage caught emails through a REST API, web UI, or terminal client.",
  "type": "module",
  "homepage": "https://github.com/Defkil/mail-debugger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defkil/mail-debugger.git"
  },
  "bugs": {
    "url": "https://github.com/Defkil/mail-debugger/issues"
  },
  "keywords": [
    "smtp",
    "email",
    "mail",
    "debugger",
    "fake-smtp",
    "maildev",
    "catch-all",
    "testing",
    "development"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "mail-debugger": "apps/server/dist/main.mjs"
  },
  "scripts": {
    "setup": "husky",
    "build": "nx build @mail-debugger/server",
    "prepack": "nx build @mail-debugger/server --skip-nx-cache"
  },
  "files": [
    "apps/server/dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@elysiajs/node": "1.4.5",
    "@elysiajs/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.52",
    "elysia": "1.4.30",
    "mailparser": "3.9.38",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "selfsigned": "5.5.0",
    "smtp-server": "3.19.21",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/node": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/svelte-query": "6.3.1",
    "@tanstack/svelte-table": "9.2.8",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/smtp-server": "3.5.13",
    "@types/sql.js": "1.4.11",
    "esbuild": "0.28.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "9.1.7",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.4.0",
    "nodemailer": "10.1.0",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "8.3.4",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@12.11.2"
}
