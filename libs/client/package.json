{
  "name": "@mail-debugger/client",
  "version": "0.0.1",
  "private": true,
  "description": "Typed client and wire types of the mail-debugger REST API, published as mail-debugger/client.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "mail-debugger": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "client",
    "targets": {
      "test": {
        "command": "vitest run",
        "options": {
          "cwd": "libs/client"
        }
      }
    }
  }
}
