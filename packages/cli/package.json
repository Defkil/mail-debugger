{
  "name": "mail-debugger-cli",
  "version": "0.3.2",
  "license": "MIT",
  "description": "Interactive terminal client for Mail Debugger. Browse, filter, and manage caught emails from the command line via TUI or direct commands.",
  "type": "module",
  "homepage": "https://github.com/Defkil/mail-debugger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defkil/mail-debugger.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Defkil/mail-debugger/issues"
  },
  "keywords": [
    "smtp",
    "email",
    "mail",
    "debugger",
    "cli",
    "tui",
    "terminal",
    "testing",
    "development"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "mail-debugger-cli": "dist/main.mjs"
  },
  "scripts": {
    "prepack": "pnpm -w exec nx build mail-debugger-cli --skip-nx-cache"
  },
  "nx": {
    "targets": {
      "sync-dist": {
        "dependsOn": [
          "@mail-debugger/cli:build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/copy-dir.mjs apps/cli/dist packages/cli/dist"
        }
      },
      "build": {
        "dependsOn": [
          "sync-dist"
        ],
        "executor": "nx:noop"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@rezi-ui/native": "0.1.0-beta.2"
  }
}
