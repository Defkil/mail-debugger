{
  "name": "mail-debugger-api",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Slim build of mail-debugger for CI: local SMTP email catcher with REST API, IMAP and MCP, without the web inbox.",
  "type": "module",
  "homepage": "https://github.com/Defkil/mail-debugger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defkil/mail-debugger.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/Defkil/mail-debugger/issues"
  },
  "keywords": [
    "smtp",
    "smtp-server",
    "email",
    "email-testing",
    "fake-smtp",
    "mail-catcher",
    "rest-api",
    "imap",
    "mcp",
    "testing",
    "ci",
    "e2e"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "bin": {
    "mail-debugger-api": "dist/main.mjs"
  },
  "scripts": {
    "prepack": "pnpm -w exec nx build mail-debugger-api --skip-nx-cache"
  },
  "nx": {
    "targets": {
      "sync-dist": {
        "dependsOn": [
          "@mail-debugger/server:build-api"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/copy-dir.mjs apps/server/dist-api packages/api/dist"
        }
      },
      "build": {
        "dependsOn": [
          "sync-dist"
        ],
        "executor": "nx:noop"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "sql.js": "1.14.2"
  }
}
