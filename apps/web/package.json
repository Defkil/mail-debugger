{
  "name": "@mail-debugger/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/build"
        ],
        "options": {
          "command": "pnpm exec svelte-kit sync && pnpm exec vite build",
          "cwd": "apps/web"
        }
      },
      "serve": {
        "continuous": true,
        "dependsOn": [
          "@mail-debugger/server:serve"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec vite dev --port 5173",
          "cwd": "apps/web"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec vitest run",
          "cwd": "apps/web"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "pnpm exec svelte-kit sync && pnpm exec svelte-check --tsconfig ./tsconfig.json",
          "cwd": "apps/web"
        }
      }
    }
  },
  "dependencies": {
    "@mail-debugger/client": "workspace:*"
  }
}
