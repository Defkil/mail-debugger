{
  "name": "@mail-debugger/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "mail-debugger": "./dist/main.mjs"
  },
  "nx": {
    "targets": {
      "compile": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/server/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/server/src/main.ts",
          "tsConfig": "apps/server/tsconfig.app.json",
          "assets": [
            "apps/server/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".mjs"
            },
            "banner": {
              "js": "#!/usr/bin/env node"
            },
            "conditions": [
              "mail-debugger"
            ],
            "external": [
              "sql.js",
              "pino",
              "pino-pretty"
            ]
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".mjs"
              },
              "banner": {
                "js": "#!/usr/bin/env node"
              },
              "conditions": [
                "mail-debugger"
              ],
              "external": [
                "sql.js",
                "pino",
                "pino-pretty"
              ]
            }
          }
        }
      },
      "compile-api": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/server/dist-api",
          "format": [
            "esm"
          ],
          "bundle": true,
          "thirdParty": true,
          "main": "apps/server/src/main-api.ts",
          "outputFileName": "main.js",
          "tsConfig": "apps/server/tsconfig.app.json",
          "assets": [],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".mjs"
            },
            "banner": {
              "js": "#!/usr/bin/env node\nimport { createRequire as __mdCreateRequire } from 'node:module';\nconst require = __mdCreateRequire(import.meta.url);"
            },
            "conditions": [
              "mail-debugger"
            ],
            "external": [
              "sql.js",
              "pino",
              "pino-pretty"
            ]
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".mjs"
              },
              "banner": {
                "js": "#!/usr/bin/env node\nimport { createRequire as __mdCreateRequire } from 'node:module';\nconst require = __mdCreateRequire(import.meta.url);"
              },
              "conditions": [
                "mail-debugger"
              ],
              "external": [
                "sql.js",
                "pino",
                "pino-pretty"
              ]
            }
          }
        }
      },
      "copy-web": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@mail-debugger/web:build",
          "compile"
        ],
        "outputs": [
          "{workspaceRoot}/apps/server/dist/web"
        ],
        "options": {
          "command": "node -e \"const fs=require('fs');fs.cpSync('apps/web/build','apps/server/dist/web',{recursive:true})\""
        }
      },
      "build": {
        "dependsOn": [
          "compile",
          "copy-web"
        ],
        "executor": "nx:noop"
      },
      "build-api": {
        "dependsOn": [
          "compile-api"
        ],
        "executor": "nx:noop"
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/server/dist/package.json",
          "{workspaceRoot}/apps/server/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/server/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/server/dist/patches",
          "{workspaceRoot}/apps/server/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "compile"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ]
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/server/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "compile"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "compile"
        ],
        "options": {
          "buildTarget": "@mail-debugger/server:compile",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@mail-debugger/server:compile:development"
          },
          "production": {
            "buildTarget": "@mail-debugger/server:compile:production"
          }
        }
      },
      "test": {
        "command": "vitest run --passWithNoTests",
        "options": {
          "cwd": "apps/server"
        }
      }
    }
  },
  "dependencies": {
    "@mail-debugger/client": "workspace:*",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "sql.js": "1.14.2",
    "srvx": "0.11.15"
  }
}
